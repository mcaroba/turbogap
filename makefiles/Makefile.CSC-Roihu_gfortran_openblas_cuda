# TurboGAP on CSC's Roihu GPU partition: Grace-Hopper GH200, so aarch64 hosts
# and sm_90 devices. Load the same environment here and in the batch script:
#
#     source /usr/share/lmod/lmod/init/bash
#     module use /appl/modulefiles
#     module load spack/aarch64/v2026_03/Core/gcc/13.4.0
#     module load spack/aarch64/v2026_03/gcc/13.4.0/openmpi/5.0.10
#     module load spack/aarch64/v2026_03/gcc/13.4.0/openblas/0.3.30
#     module load spack/aarch64/v2026_03/gcc/13.4.0/cuda/12.6.3
#
# Two things differ from the Aalto arch file beyond the architecture flag:
# CUDA's target triple is sbsa-linux, not x86_64-linux, and nvToolsExt is a
# header-only interface in CUDA 12 with no library left to link.

ifndef HOP_ROOT
  $(error HOP_ROOT environment variable not set. Please set it before building.)
endif

CUDA_HOME ?= $(shell command -v nvcc >/dev/null 2>&1 && dirname $$(dirname $$(command -v nvcc)) || echo "/usr/local/cuda")
CUDA_ARCH ?= sm_90
# CUDA's cudaGL.h includes <GL/gl.h>, which Roihu's GPU nodes do not ship, and
# hop's runtime shim pulls cudaGL.h in whether or not anything uses it. This
# directory holds four typedefs and nothing else; drop the -I the day either
# side stops needing it.
GL_STUB ?= makefiles/roihu-gl-stub
DEBUG ?= 1

F90=mpif90
PP=-cpp -D _MPIF90
F90_MOD_DIR_OPT=-J

CU=nvcc -x cu -Xcompiler=-Wall -I"$(HOP_ROOT)" -I"$(HOP_ROOT)/source/hip" -arch=$(CUDA_ARCH) -DHOP_TARGET_CUDA -DCUDA -I"$(GL_STUB)"
CC=nvcc -x cu -Xcompiler=-Wall -std=c++20 -arch=$(CUDA_ARCH) -I"$(HOP_ROOT)" -I"$(HOP_ROOT)/source/hip" -DHOP_TARGET_CUDA -DCUDA -I"$(GL_STUB)"

ifeq ($(DEBUG),1)
  CU += -g -G
  CC += -g -G
  F90_OPTS =  -g3 -ggdb -fPIC -ffree-line-length-none -fallow-argument-mismatch
else
  CU += -O3
  CC += -O3
  F90_OPTS =  -O2 -fPIC -ffree-line-length-none -fallow-argument-mismatch
endif

# The driver stub lives one level down from the runtime libraries, and only the
# stub is present on a login node -- linking against it is the normal way to
# build for a device that is not attached to the machine doing the build.
CUDA_LIB_PATH = "$(CUDA_HOME)/targets/sbsa-linux/lib"
LIBS = -L$(CUDA_LIB_PATH) -L$(CUDA_LIB_PATH)/stubs -lopenblas -lcudart -lcuda -lcublas -lstdc++
