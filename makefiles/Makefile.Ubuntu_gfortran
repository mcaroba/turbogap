# User-modifiable variables below

# Compiler, preprocessor directives, etc.
F90=gfortran
PP=-cpp
F90_MOD_DIR_OPT=-J

# Optimization flags
F90_OPTS=-fPIC -O3
# For a debug build use `make DEBUG=1`, which appends -O0 -g -fbacktrace
# -fcheck=all to whatever this line sets and puts the result in build-dbg/
# and bin-dbg/. Editing this line instead reuses the same object tree, so
# make rebuilds only what changed and links the rest of the optimised
# objects -- and afterwards bin/turbogap is a mixture with nothing to say so.

# BLAS and LAPACK libraries
LIBS=-llapack -lblas
#LAPACK_LIB_DIR=
#LIBS=-L$(LAPACK_LIB_DIR) -llapack -lblas
