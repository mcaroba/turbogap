! Amorphous carbon driven towards graphite by its XPS C1s line: one Gaussian at
! 284.25 eV, sigma 0.2 eV, where this potential puts a three-fold carbon (the
! 432 sp2 sites here predict 284.299 +/- 0.386 eV, the 35 sp3 sites 285.393 +/-
! 0.433). The gradient it pulls on is dCEBE/dr.
!
! sigma is deliberately narrower than the 0.386 eV spread of the sites: at 0.4
! eV the two curves already overlap 96% and there is nothing to pull on, at 0.2
! eV 86%. exp_n_samples matches the target's 601 points, 0.005 eV apart.
!
! Five steps: a coverage case, not a graphitisation run.

! Species-specific info
atoms_file = 'atoms.xyz'
pot_file = 'gap_files/CO.gap'
n_species = 2
species = C O
masses = 12.01 15.99
e0 = -.16138053 0.

! --- Experimental data specification (MAD) ---
n_exp = 1
exp_labels = 'xps'
exp_data_files = 'xps_graphite_sp2_284.25.dat'
exp_n_samples = 601
exp_energy_scales = 14.69

exp_energies = .true.
exp_forces   = .true.

! Broadening of the predicted binding energies, matching the target's width.
xps_sigma = 0.2

! --- MD ---
md_nsteps = 5
md_step = 1.0
thermostat = berendsen
t_beg = 1000
t_end = 1000
random_seed = 12345
write_xyz = 1

! See case.conf: pinned so the two binaries use the same skin.
neighbors_buffer = 0
