atoms_file = "atoms.xyz"
pot_file = "gap_files/CO.gap"
n_species = 2
species = C O
masses = 12.01 15.99
e0 = -.16138053 0.
random_seed = 12345

md_nsteps = 15
optimize = "gd-box-ortho"
e_tol = 1.d-8
f_tol = 0.005
p_tol = 0.5
write_xyz = 5
write_thermo = 1
write_lv = .true.

! Pinned because this case's expected/ output predates neighbors_buffer
! defaulting to 0.5. Padding the neighbour list does not change which pairs a
! descriptor sees -- gap_interface drops everything beyond its own cutoff --
! but it changes the order they are summed in, and that moves the last digit;
! here it moved a force from ...96610 to ...96611. Pinned to 0 so the stored
! expectation stays a real regression check rather than being reblessed over a
! deliberate default change. The default has its own case, neighbors_skin.
neighbors_buffer = 0
