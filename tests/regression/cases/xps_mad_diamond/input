! Amorphous carbon driven towards diamond by its XPS C1s line: one Gaussian at
! 285.35 eV, sigma 0.2 eV, where this potential puts a four-fold carbon (the 35
! sp3 sites here predict 285.393 +/- 0.433 eV against 284.299 +/- 0.386 for the
! 432 sp2 sites). It asks for the opposite network to xps_mad_graphite, from
! the same starting structure.
!
! sigma is deliberately narrower than the 0.433 eV spread of the sites, and the
! window is 1.5 eV either side of the peak: see case.conf for what both cost.
!
! Five steps: a coverage case, not a diamond-formation run.

! Species-specific info
atoms_file = 'atoms.xyz'
pot_file = 'gap_files/CO.gap'
n_species = 2
species = C O
masses = 12.01 15.99
e0 = -.16138053 0.

! --- Experimental data specification (MAD) ---
n_exp = 1
exp_labels = 'xps'
exp_data_files = 'xps_diamond_sp3_285.35.dat'
exp_n_samples = 601
exp_energy_scales = 2.48

exp_energies = .true.
exp_forces   = .true.

! Broadening of the predicted binding energies, matching the target's width.
xps_sigma = 0.2

! --- MD ---
md_nsteps = 5
md_step = 1.0
thermostat = berendsen
t_beg = 1000
t_end = 1000
random_seed = 12345
write_xyz = 1

! See case.conf: pinned so the two binaries use the same skin.
neighbors_buffer = 0
